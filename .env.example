# Supabase Public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server (Service Role - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App channel (mobile client)
# Shared secret required on POST /api/app/session (header x-app-secret).
APP_CHANNEL_SECRET=generate-random-32-byte-hex-secret
# Optional alias; if unset, APP_CHANNEL_SECRET or CRM_INTERNAL_SECRET is used for app JWTs.
# CRM_INTERNAL_SECRET is still required for internal AI/reply jobs.
CRM_INTERNAL_SECRET=generate-random-32-byte-hex-secret

# Optional FCM server key for push notifications to app_devices
# FCM_SERVER_KEY=your-firebase-cloud-messaging-server-key

# AI Engine (Groq)
GROQ_API_KEY=your-groq-api-key
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Encrypts organization integration credentials at rest.
# Keep stable: rotating it requires re-encrypting every saved credential.
INTEGRATION_ENCRYPTION_KEY=generate-another-random-32-byte-hex-secret

# Wispro & Payments Integrations
# Legacy fallback only. New organizations configure Wispro from CRM Settings.
WISPRO_API_KEY=your-wispro-api-key
WISPRO_API_TOKEN=your-wispro-api-token
WISPRO_BASE_URL=https://www.cloud.wispro.co/api/v1
INNOVER_PAYMENTS_API_URL=https://backend-innover.vercel.app/api/v1/payments

# Supabase Storage Buckets (app channel media)
SUPABASE_APP_MEDIA_BUCKET=app-media
# Legacy aliases still accepted by upload helpers:
# SUPABASE_WHATSAPP_AUDIO_BUCKET=audio-bucket
# SUPABASE_WHATSAPP_IMAGE_BUCKET=image-bucket
# SUPABASE_WHATSAPP_VIDEO_BUCKET=video-bucket
# SUPABASE_WHATSAPP_DOCUMENT_BUCKET=document-bucket

# Optional BCV rate URL
# DOLARVZLA_API_URL=https://rates.dolarvzla.com/bcv/current.json
